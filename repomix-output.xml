                        {img.width}×{img.height}
                      </span>
                      <a
                        href={img.dataUrl}
                        download={img.name}
                        className="p-1 rounded text-zinc-400 hover:text-emerald-400 hover:bg-zinc-800 transition"
                        title="Download image"
