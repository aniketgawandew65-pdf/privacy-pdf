{
  "name": "local-pdf-to-docx-experiment",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5192 --strictPort",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1 --port 5192 --strictPort",
    "format:check": "prettier --check src tests scripts index.html vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "docx": "9.7.1",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "pdf-lib": "1.17.1",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
